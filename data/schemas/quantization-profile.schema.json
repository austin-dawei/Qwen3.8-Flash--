{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quantization-profile.schema.json",
  "title": "Weight or KV-cache quantization profiles",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "default_profile": { "type": "string" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "display_name": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
