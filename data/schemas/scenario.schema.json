{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Qwen3.8-Flash-Next analysis scenario",
  "type": "object",
  "required": [
    "schema_version", "name", "model_id", "weight_quantization",
    "kv_cache_quantization", "context_length", "batch_size",
    "include_ngram", "ngram_quantization", "include_vision", "vision_quantization",
    "include_mtp", "mtp_quantization", "operator_detail"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "model_id": {"const": "qwen3.8-flash-next"},
    "weight_quantization": {"type": "string", "minLength": 1},
    "kv_cache_quantization": {"type": "string", "minLength": 1},
    "context_length": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 1024},
    "include_ngram": {"type": "boolean"},
    "ngram_quantization": {"enum": ["inherit", "bf16", "fp8", "w4-effective-425", "w4-raw"]},
    "include_vision": {"type": "boolean"},
    "vision_quantization": {"enum": ["inherit", "bf16", "fp8", "w4-effective-425", "w4-raw"]},
    "include_mtp": {"type": "boolean"},
    "mtp_quantization": {"enum": ["inherit", "bf16", "fp8", "w4-effective-425", "w4-raw"]},
    "operator_detail": {"enum": ["module", "expanded"]}
  },
  "additionalProperties": false
}
